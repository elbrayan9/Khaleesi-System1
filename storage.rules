rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Comprobantes (PDF) para enviar por WhatsApp:
    // - Escribe SOLO el dueño (usuario autenticado) en su propia carpeta.
    // - Lectura pública por link (el download URL de Firebase ya trae token).
    // - Límite de 5 MB y solo PDFs.
    match /comprobantes/{userId}/{allPaths=**} {
      // **Bajar uno, sí. Ver la lista, no.**
      //
      // Estaba como `read: if true`, y en Storage `read` incluye listar: con el
      // identificador del comercio —que no es secreto— cualquiera podía pedir
      // el contenido de su carpeta y bajarse TODAS sus facturas, con el nombre,
      // el CUIT y el domicilio de sus clientes adentro.
      //
      // `get` queda abierto a propósito: el comprobante que el comercio le
      // manda a su cliente por WhatsApp es un enlace que esa persona abre sin
      // tener cuenta. Cerrarlo sin reemplazarlo por un enlace firmado dejaría a
      // los clientes sin poder ver su factura.
      //
      // Queda pendiente pasar ese envío a enlaces firmados con vencimiento,
      // generados desde una función: recién ahí se puede cerrar también el
      // `get`. Hasta entonces, para bajar un comprobante hay que saber su
      // nombre exacto, que lleva la marca de tiempo en milisegundos.
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Imágenes de productos:
    // - Escribe SOLO el dueño en su propia carpeta.
    // - Lectura pública (para el catálogo/consulta de precios por QR).
    // - Límite de 5 MB y solo imágenes.
    match /productos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Logo del negocio (aparece en la factura):
    // - Escribe SOLO el dueño. Lectura pública (para el PDF). Máx 3 MB, imágenes.
    match /logos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
