rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() { return request.auth.token.admin == true; }
    function isUserActive() {
      return exists(/databases/$(database)/documents/datosNegocio/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/datosNegocio/$(request.auth.uid)).data.subscriptionStatus in ['active', 'trial'];
    }

    // datosNegocio: leer dueño/admin; editar solo activo/admin.
    //
    // **Lo que el comercio NO puede tocar de su propio documento.**
    //
    // Acá vive lo que decide qué puede usar y hasta cuándo: el plan y el estado
    // de la suscripción. El servidor los lee para habilitar la facturación
    // ante ARCA, las funciones con IA y la tienda online. Como el dueño puede
    // escribir su propio documento, sin esta restricción le alcanzaba con una
    // línea en la consola del navegador para ponerse `plan: 'premium'` y una
    // fecha de vencimiento en 2099, y usar gratis todo lo que se cobra.
    //
    // Esos campos los escriben únicamente el webhook de Mercado Pago y el
    // administrador, los dos con el Admin SDK, que no pasa por estas reglas.
    function tocaLaSuscripcion() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['plan', 'subscriptionStatus', 'subscriptionEndDate',
                 'precioLegacy', 'precioLegacyHasta']);
    }
    function traeLaSuscripcion() {
      return request.resource.data.keys()
        .hasAny(['plan', 'subscriptionStatus', 'subscriptionEndDate',
                 'precioLegacy', 'precioLegacyHasta']);
    }

    match /datosNegocio/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && !traeLaSuscripcion());
      allow update: if isAdmin() ||
                       (isOwner(userId) && isUserActive() && !tocaLaSuscripcion());
      allow delete: if isAdmin();
    }

    // productos.
    // `get` (un producto por su id) queda público: es lo que necesita la página
    // del QR que el cliente escanea en la góndola, y hay que conocer el id.
    // `list` (consultar la colección) NO: abierto permitía descargar el catálogo
    // completo de TODOS los comercios, con costo y stock. La tienda online ya no
    // lo necesita — su catálogo lo sirve la función getProductosTienda.
    match /productos/{productId} {
      allow get: if true;
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow create: if (isOwner(request.resource.data.userId) && isUserActive()) || isAdmin();
      allow update, delete: if (isOwner(resource.data.userId) && isUserActive()) || isAdmin();
    }

    // NUEVO: sucursales. El dueño puede LEER y CREAR su sucursal aunque esté
    // vencido (es lo MÍNIMO para que la app cargue y le muestre "pagá acá").
    // EDITAR la config sigue requiriendo estar activo.
    match /sucursales/{sucursalId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update, delete: if (isOwner(resource.data.userId) && isUserActive()) || isAdmin();
    }

    // El puente entre el celular que escanea y la caja.
    //
    // Escuchar un documento que TODAVÍA NO EXISTE daba "Missing or insufficient
    // permissions": la regla general mira `resource.data.userId`, y en un
    // documento inexistente eso no está. El listener moría en el arranque y el
    // celular como pistola no se enganchaba hasta recargar la página.
    //
    // Leer un documento que no existe no filtra nada —viene vacío— así que se
    // permite, y en cuanto tiene contenido vuelve a mandar el dueño. Escribir
    // sigue siendo solo del dueño.
    match /scannerRelay/{sucursalId} {
      allow get: if resource == null ||
                    isOwner(resource.data.userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Los Access Token de Mercado Pago de los comercios.
    //
    // Cerrado para TODO el mundo, admin incluido: nadie los necesita desde el
    // navegador. Las Cloud Functions los leen con el Admin SDK, que no pasa por
    // estas reglas.
    //
    // Antes el token vivía dentro de la configuración de la sucursal, y ese
    // documento se descarga entero al navegador del dueño: quedaba en memoria
    // del cliente y en el IndexedDB de la computadora del local, al alcance de
    // cualquier XSS.
    match /secretosMp/{docId} {
      allow read, write: if false;
    }

    // El caché de direcciones ya buscadas y los contadores internos.
    //
    // Cerradas para el cliente: las escriben y leen solo las Cloud Functions
    // con el Admin SDK. `geocache` guarda direcciones de gente que hizo
    // pedidos, así que no tiene por qué estar al alcance de ningún navegador;
    // `contadores` son los frenos anti-abuso, y verlos es media ayuda para
    // esquivarlos.
    match /geocache/{docId} {
      allow read, write: if false;
    }
    match /contadores/{docId} {
      allow read, write: if false;
    }

    // Los topes diarios de las funciones con IA y los avisos al administrador.
    //
    // `_usage_daily` quedaba bajo la regla general, y su identificador es
    // predecible (`<uid>_<fecha>`). Alcanzaba con crear el documento del día a
    // nombre propio con el contador en cero para volverse dueño de él y poder
    // resetearlo cuando quisiera: el tope de llamadas a la IA dejaba de existir
    // y el costo lo pagaba el sistema.
    match /_usage_daily/{docId} {
      allow read, write: if false;
    }
    match /paymentNotifications/{docId} {
      allow read, write: if false;
    }
    // Los pagos de suscripción ya usados, para que un mismo comprobante no
    // sirva dos veces.
    match /pagosProcesados/{docId} {
      allow read, write: if false;
    }

    // Resto (ventas, clientes, notas, etc.): IGUAL que tenías, ahora excluyendo
    // también 'sucursales', 'secretosMp', 'geocache' y 'contadores'.
    //
    // Lo de secretosMp acá arriba no es redundante con el `if false`: en
    // Firestore alcanza con que UNA regla permita para que el acceso se
    // conceda, no gana la más específica. Si no se excluyera del comodín, el
    // día que un documento de secretos tuviera un campo `userId` quedaría
    // legible por su dueño.
    match /{collection}/{docId} {
      allow read, update, delete: if (collection != 'datosNegocio' && collection != 'productos' && collection != 'sucursales' && collection != 'secretosMp' && collection != 'geocache' && collection != 'contadores' && collection != 'scannerRelay' && collection != '_usage_daily' && collection != 'paymentNotifications' && collection != 'pagosProcesados') &&
                     ((isOwner(resource.data.userId) && isUserActive()) || isAdmin());
      allow create: if (collection != 'datosNegocio' && collection != 'productos' && collection != 'sucursales' && collection != 'secretosMp' && collection != 'geocache' && collection != 'contadores' && collection != 'scannerRelay' && collection != '_usage_daily' && collection != 'paymentNotifications' && collection != 'pagosProcesados') &&
                     ((isOwner(request.resource.data.userId) && isUserActive()) || isAdmin());
    }
  }
}
